# ==============================================================================
# alterego Configuration
# ==============================================================================

# Persona settings
PERSONA_NAME=YourName
PERSONA_DIR=persona

# ------------------------------------------------------------------------------
# LLM Provider Configuration (OpenAI-compatible endpoint)
# ------------------------------------------------------------------------------

# Option 1: Groq (Default - Free tier, high speed)
# Documentation & keys: https://console.groq.com/keys | https://console.groq.com/docs/models
# Verified active models: llama-3.3-70b-versatile, llama-3.1-8b-instant, openai/gpt-oss-120b, openai/gpt-oss-20b
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=gsk_your_groq_api_key_here

# Option 2: Google Gemini (Alternative - Free tier via OpenAI-compatible endpoint)
# Documentation & keys: https://aistudio.google.com/ | https://ai.google.dev/gemini-api/docs/openai
# Verified active models: gemini-2.5-flash, gemini-2.0-flash, gemini-3.8-flash
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=AIzaSy_your_gemini_api_key_here

# Optional LLM tuning
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=600
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3

# Application settings
APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Telegram Bot Configuration
# ------------------------------------------------------------------------------
# Get your bot token from @BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_example
# A random secret string used to verify incoming webhook requests from Telegram
# Generate with: openssl rand -hex 24 (or python -c "import secrets; print(secrets.token_hex(24))")
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_token_here
